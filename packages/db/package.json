{
  "name": "@mindpay/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf coverage dist",
    "generate": "drizzle-kit generate --config drizzle.config.ts",
    "migrations:verify": "node ./scripts/verify-migrations.mjs",
    "test": "pnpm migrations:verify && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "drizzle-kit": "catalog:",
    "wrangler": "catalog:"
  }
}
