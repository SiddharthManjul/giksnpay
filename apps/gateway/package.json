{
  "name": "@mindpay/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "WRANGLER_LOG=none WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir dist",
    "clean": "rm -rf coverage dist",
    "deploy": "node ./scripts/deploy-production.mjs",
    "deploy:check": "node ./scripts/deploy-production.mjs --check",
    "dev": "wrangler dev --port 8787 --inspector-port 9229 --var TRUSTED_ORIGINS:http://localhost:3100",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "catalog:",
    "@mindpay/agent-runtime": "workspace:*",
    "@mindpay/audit": "workspace:*",
    "@mindpay/config": "workspace:*",
    "@mindpay/contracts": "workspace:*",
    "@mindpay/crypto": "workspace:*",
    "@mindpay/db": "workspace:*",
    "@mindpay/domain": "workspace:*",
    "@mindpay/mcp-tools": "workspace:*",
    "@mindpay/policy-engine": "workspace:*",
    "@mindpay/protocol-acp": "workspace:*",
    "@mindpay/protocol-mandates": "workspace:*",
    "@mindpay/risk-engine": "workspace:*",
    "@simplewebauthn/server": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "miniflare": "catalog:"
  }
}
