{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mindpay-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "AGENT_MODEL_NAME": "gpt-5-mini",
    "AGENT_MODEL_PROVIDER": "openai",
    "BETTER_AUTH_URL": "http://localhost:8787",
    "ENVIRONMENT": "development",
    "MINDPAY_API_AUDIENCE": "https://api.mindpay.example/",
    "PASSKEY_RP_ID": "localhost",
    "TRUSTED_ORIGINS": "http://localhost:3000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mindpay-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MARKETPLACE_CACHE",
      "id": "00000000000000000000000000000001",
      "preview_id": "00000000000000000000000000000001"
    }
  ],
  "services": [
    {
      "binding": "SIGNALWORKS",
      "service": "mindpay-signalworks"
    }
  ]
}
