{
  "name": "@mindpay/merchant-signalworks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "WRANGLER_LOG=none WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir dist",
    "clean": "rm -rf coverage dist",
    "deploy": "wrangler deploy --config wrangler.production.jsonc",
    "dev": "wrangler dev --port 8788 --inspector-port 9230",
    "seed:local": "tsx ./scripts/seed-local.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "catalog:",
    "@mindpay/config": "workspace:*",
    "@mindpay/contracts": "workspace:*",
    "@mindpay/crypto": "workspace:*",
    "@mindpay/domain": "workspace:*",
    "@mindpay/protocol-acp": "workspace:*",
    "@mindpay/razorpay": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "miniflare": "catalog:",
    "tsx": "catalog:",
    "wrangler": "catalog:"
  }
}
