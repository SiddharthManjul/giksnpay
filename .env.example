# MindPay environment reference
#
# This file documents every application-controlled environment variable needed through Phase 7.
# It is not loaded automatically by Wrangler and must never contain real credentials.
#
# For local development, copy only the relevant secret variables into:
#   apps/gateway/.dev.vars
#   apps/merchant-signalworks/.dev.vars
#
# Keep non-secret deployment values in the relevant wrangler.jsonc. Do not copy the whole file into
# both Workers: Gateway and SignalWorks intentionally have separate secret boundaries.

# -----------------------------------------------------------------------------
# Cloudflare deployment authentication (CI only)
# -----------------------------------------------------------------------------

# Local development does not need either value: use `pnpm wrangler login --use-keyring` instead.
# Non-interactive CI/CD needs the target account ID and one scoped API token.
CLOUDFLARE_ACCOUNT_ID=CHANGE_ME
CLOUDFLARE_API_TOKEN=CHANGE_ME

# -----------------------------------------------------------------------------
# Shared runtime values
# -----------------------------------------------------------------------------

# Allowed values: development, test, preview, production.
ENVIRONMENT=development

# Exact audience used when Gateway verifies signed SignalWorks payment events.
# Keep this identical anywhere the merchant creates or Gateway verifies those events.
# Production deployment derives this from MINDPAY_GATEWAY_ORIGIN.
MINDPAY_API_AUDIENCE=https://api.mindpay.example/

# Shared bearer token used only for Gateway <-> SignalWorks server-to-server calls.
# Required for Phase 7. Use the same value in both Workers.
# Constraint: 32-512 printable ASCII characters with no spaces.
SIGNALWORKS_MACHINE_AUTH_TOKEN=CHANGE_ME

# -----------------------------------------------------------------------------
# MindPay Gateway: authentication and browser security
# -----------------------------------------------------------------------------

# Required. Use a unique high-entropy value of 32-1024 characters.
BETTER_AUTH_SECRET=CHANGE_ME

# Gateway's absolute origin. Preview and production must use HTTPS.
BETTER_AUTH_URL=http://localhost:8787

# Comma-separated exact browser origins. Preview and production must use HTTPS.
TRUSTED_ORIGINS=http://localhost:3100

# Must be localhost or a DNS suffix that contains every TRUSTED_ORIGINS hostname.
PASSKEY_RP_ID=localhost

# Required only by `pnpm --filter @mindpay/gateway deploy`. These are public, non-secret values.
# For workers.dev, the RP ID is the shared `<account>.workers.dev` parent of both Worker origins.
MINDPAY_GATEWAY_ORIGIN=https://mindpay-gateway.your-account.workers.dev
MINDPAY_WEB_ORIGIN=https://mindpay-web.your-account.workers.dev
MINDPAY_PASSKEY_RP_ID=your-account.workers.dev

# Required for agent signing keys. Generate exactly 32 random bytes encoded as unpadded base64url.
# Example generator: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
AGENT_KEY_ENCRYPTION_KEY=CHANGE_ME

# -----------------------------------------------------------------------------
# MindPay Gateway: live model integration
# -----------------------------------------------------------------------------

# Primary provider for live agent runs.
AGENT_MODEL_PROVIDER=google

# Current stable Flash model used by MindPay.
AGENT_MODEL_NAME=gemini-3.8-flash

# Required only for live AI agent runs. Manual procurement and deterministic tests work without it.
# Constraint: 20-512 printable ASCII characters with no spaces.
GOOGLE_GENERATIVE_AI_API_KEY=CHANGE_ME

# To use OpenAI in the future, change AGENT_MODEL_PROVIDER to `openai`, choose an OpenAI model,
# remove GOOGLE_GENERATIVE_AI_API_KEY from that Worker's environment, and set this secret:
# OPENAI_API_KEY=CHANGE_ME

# -----------------------------------------------------------------------------
# SignalWorks: merchant signing identity
# -----------------------------------------------------------------------------

# Required. Keep this stable for the life of the SignalWorks database.
# Generate exactly 32 random bytes encoded as unpadded base64url.
# Example generator: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
SIGNALWORKS_KEY_ENCRYPTION_KEY=CHANGE_ME

# -----------------------------------------------------------------------------
# SignalWorks: Razorpay Test Mode
# -----------------------------------------------------------------------------

# Required for the real Phase 7 payment test. Test Mode IDs must start with rzp_test_.
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME

# Required. Use the Test Mode key secret paired with RAZORPAY_KEY_ID.
# Constraint: 16-256 printable ASCII characters with no spaces.
RAZORPAY_KEY_SECRET=CHANGE_ME

# Required. Create this separately when registering the Razorpay webhook endpoint.
# Do not reuse RAZORPAY_KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# Optional during a planned webhook-secret rotation. Leave unset otherwise.
# RAZORPAY_WEBHOOK_OLD_SECRET=CHANGE_ME

# Optional features. Keep both disabled for the initial purchase-path test.
RAZORPAY_REFUNDS_ENABLED=false
RAZORPAY_MCP_READONLY_ENABLED=false

# -----------------------------------------------------------------------------
# Test tooling
# -----------------------------------------------------------------------------

# Optional. Playwright defaults to http://127.0.0.1:3310 when this is unset.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3310

# -----------------------------------------------------------------------------
# Cloudflare bindings are resources, not dotenv variables
# -----------------------------------------------------------------------------
#
# Gateway requires:
#   DB                 D1 database
#   MARKETPLACE_CACHE  KV namespace
#   SIGNALWORKS        service binding to the SignalWorks Worker
#
# SignalWorks requires:
#   DB                separate D1 database
#   PAYMENT_EVIDENCE  private R2 bucket
#   PAYMENT_EVENTS    Queue with a dead-letter queue
#   MINDPAY_GATEWAY   service binding to the Gateway Worker
# Its workers.dev public origin will follow this shape:
#   https://mindpay-signalworks.your-account.workers.dev
